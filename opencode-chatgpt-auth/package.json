{
  "name": "opencode-chatgpt-auth",
  "version": "0.1.0",
  "description": "Enable OpenCode to use ChatGPT Plus subscription models (Codex, GPT-4o, o3, etc.) via session token authentication",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "opencode",
    "chatgpt",
    "codex",
    "openai",
    "plugin",
    "auth"
  ],
  "license": "MIT",
  "dependencies": {
    "@opencode-ai/plugin": "^0.0.3"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "@types/node": "^22.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}

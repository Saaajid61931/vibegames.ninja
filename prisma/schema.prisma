// VibeGames.Ninja Database Schema
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MobileOrientation {
  BOTH
  PORTRAIT
  LANDSCAPE
}

enum GameBuildSource {
  UPLOAD
  BUILDER
}

enum BuilderProjectStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum BuilderMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

// User & Auth Models
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  username      String?   @unique
  password      String?
  image         String?
  bio           String?
  currentlyBuilding String?
  role          String    @default("USER") // USER, CREATOR, ADMIN
  isPro         Boolean   @default(false)
  proExpiresAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  games         Game[]
  favorites     Favorite[]
  followers     CreatorFollow[] @relation("CreatorFollowers")
  following     CreatorFollow[] @relation("CreatorFollowing")
  comments      Comment[]
  gameFeedback  GameFeedback[]
  ghostRuns     GhostRun[]
  levels        Level[]
  levelRatings  LevelRating[]
  gameRatings   GameRating[]
  earnings      Earnings[]
  notifications Notification[]
  usernameRedirects UsernameRedirect[]

  studioProfiles StudioProfile[]
  featuredPicks  FeaturedGame[]
  jamEntries     GameJamEntry[]
  jamVotes       GameJamVote[]
  createdJams    GameJam[]
  builderProjects BuilderProject[]
}

model UsernameRedirect {
  id          String   @id @default(cuid())
  oldUsername String   @unique
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Game Models
model Game {
  id             String  @id @default(cuid())
  slug           String  @unique
  title          String
  description    String
  instructions   String?
  thumbnail      String?
  thumbnailSlides String[] @default([])
  gameUrl        String
  category       String  @default("OTHER") // ACTION, PUZZLE, ARCADE, etc.
  tags           String // Comma-separated tags
  status         String  @default("PENDING") // DRAFT, PENDING, PUBLISHED, REJECTED, SUSPENDED, EXPIRED
  isAIGenerated  Boolean @default(true)
  aiTool         String? // Which AI tool was used (Claude, GPT, etc.)
  aiModel        String? // Specific model used (gpt-4o, claude-3-7-sonnet, etc.)
  supportsMobile Boolean @default(false)
  mobileOrientation MobileOrientation @default(BOTH)
  hasLevelEditor Boolean @default(false)
  hasGhostSharing Boolean @default(false)

  isPremium Boolean @default(false)
  price     Float?
  hasAds    Boolean @default(true)
  seekingFeedback Boolean @default(false)
  latestUpdateNote String?

  plays       Int   @default(0)
  likes       Int   @default(0)
  shares      Int   @default(0)
  avgRating   Float @default(0)
  ratingCount Int   @default(0)

  // Legacy retention fields (no longer used for automatic expiration)
  expiresAt   DateTime?
  isPermanent Boolean   @default(false)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  publishedAt DateTime?
  buildSource GameBuildSource @default(UPLOAD)

  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  // Optional publishing identity (studio/brand profile) owned by a real user
  studioProfileId String?
  studioProfile   StudioProfile? @relation(fields: [studioProfileId], references: [id], onDelete: SetNull)
  sourceProjectId String? @unique
  sourceProject   BuilderProject? @relation("BuilderSourceGame", fields: [sourceProjectId], references: [id], onDelete: SetNull)

  analytics    GameAnalytics[]
  favorites    Favorite[]
  comments     Comment[]
  feedback     GameFeedback[]
  ghostRuns    GhostRun[]
  levels       Level[]
  ratings      GameRating[]
  reports      Report[]
  featuredDays FeaturedGame[]
  jamEntries   GameJamEntry[]

  @@index([status, publishedAt])
  @@index([status, plays])
  @@index([status, likes])
  @@index([status, category])
  @@index([creatorId, status])
  @@index([studioProfileId, status])
}

model BuilderProject {
  id                String               @id @default(cuid())
  ownerId           String
  owner             User                 @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  templateKey       String
  status            BuilderProjectStatus @default(DRAFT)
  category          String               @default("ARCADE")
  tags              String               @default("")
  supportsMobile    Boolean              @default(true)
  mobileOrientation MobileOrientation    @default(BOTH)
  thumbnail         String?
  currentRevisionId String?
  publishedRevisionId String?
  currentRevision   BuilderRevision?     @relation("BuilderCurrentRevision", fields: [currentRevisionId], references: [id], onDelete: SetNull)
  publishedRevision BuilderRevision?     @relation("BuilderPublishedRevision", fields: [publishedRevisionId], references: [id], onDelete: SetNull)
  revisions         BuilderRevision[]    @relation("BuilderProjectRevisions")
  messages          BuilderMessage[]
  publishedGame     Game?                @relation("BuilderSourceGame")
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([ownerId, updatedAt])
  @@index([status, updatedAt])
}

model BuilderRevision {
  id            String            @id @default(cuid())
  projectId     String
  project       BuilderProject    @relation("BuilderProjectRevisions", fields: [projectId], references: [id], onDelete: Cascade)
  prompt        String
  actionKey     String?
  summary       String
  config        Json
  snapshot      Json?
  previewUrl    String
  artifactUrl   String?
  createdAt     DateTime          @default(now())
  currentForProjects BuilderProject[] @relation("BuilderCurrentRevision")
  publishedForProjects BuilderProject[] @relation("BuilderPublishedRevision")
  messages      BuilderMessage[]

  @@index([projectId, createdAt])
}

model BuilderMessage {
  id         String             @id @default(cuid())
  projectId  String
  project    BuilderProject     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  revisionId String?
  revision   BuilderRevision?   @relation(fields: [revisionId], references: [id], onDelete: SetNull)
  role       BuilderMessageRole
  content    String
  createdAt  DateTime           @default(now())

  @@index([projectId, createdAt])
}

model StudioProfile {
  id      String @id @default(cuid())
  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Public handle for the studio/brand (used in URLs)
  handle      String  @unique
  displayName String
  image       String?
  bio         String?
  currentlyBuilding String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  games Game[]

  @@index([ownerId])
}

model GameAnalytics {
  id             String   @id @default(cuid())
  gameId         String
  game           Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  date           DateTime @default(now())
  plays          Int      @default(0)
  uniquePlayers  Int      @default(0)
  avgSessionTime Float    @default(0)
  bounceRate     Float    @default(0)
  adImpressions  Int      @default(0)
  adClicks       Int      @default(0)
  revenue        Float    @default(0)

  @@unique([gameId, date])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, gameId])
  @@index([userId, createdAt])
}

model CreatorFollow {
  id         String   @id @default(cuid())
  followerId String
  creatorId  String
  createdAt  DateTime @default(now())

  follower User @relation("CreatorFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  creator  User @relation("CreatorFollowers", fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([followerId, creatorId])
  @@index([creatorId])
  @@index([followerId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([gameId, createdAt])
}

model Level {
  id          String   @id @default(cuid())
  name        String
  description String?
  data        Json
  thumbnail   String?
  status      String   @default("PUBLISHED") // PUBLISHED, HIDDEN, REMOVED
  plays       Int      @default(0)
  avgRating   Float    @default(0)
  ratingCount Int      @default(0)
  gameId      String
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  creatorId   String
  creator     User     @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ratings LevelRating[]
  ghostRuns GhostRun[]

  @@index([gameId, status, createdAt])
  @@index([gameId, status, avgRating])
  @@index([creatorId, createdAt])
}

model LevelRating {
  id        String   @id @default(cuid())
  score     Int
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  levelId   String
  level     Level    @relation(fields: [levelId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, levelId])
  @@index([levelId])
}

model GameRating {
  id        String   @id @default(cuid())
  score     Int
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  gameId    String
  game      Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, gameId])
  @@index([gameId])
}

model GameFeedback {
  id         String   @id @default(cuid())
  gameId      String
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fun         Boolean  @default(false)
  confusing   Boolean  @default(false)
  tooHard     Boolean  @default(false)
  buggy       Boolean  @default(false)
  comment     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, gameId])
  @@index([gameId, createdAt])
}

model GhostRun {
  id            String   @id @default(cuid())
  gameId        String
  game          Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  levelId       String?
  level         Level?   @relation(fields: [levelId], references: [id], onDelete: Cascade)
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  durationMs    Int
  replayData    Json
  replayVersion String?
  checksum      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([gameId, createdAt])
  @@index([gameId, levelId, durationMs])
  @@index([userId, gameId, levelId, durationMs])
}

model Earnings {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  type        String // AD_REVENUE, GAME_SALE, TIP, REFERRAL
  status      String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  description String?
  createdAt   DateTime  @default(now())
  paidAt      DateTime?
}

model Subscription {
  id               String    @id @default(cuid())
  email            String
  type             String // CREATOR_PRO, PLAYER_PREMIUM
  status           String    @default("active")
  stripeCustomerId String?
  stripeSubId      String?
  currentPeriodEnd DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Report {
  id          String    @id @default(cuid())
  gameId      String
  game        Game      @relation(fields: [gameId], references: [id], onDelete: Cascade)
  reporterId  String?
  reason      String // COPYRIGHT, INAPPROPRIATE, MALWARE, SPAM, OTHER
  description String?
  status      String    @default("PENDING") // PENDING, REVIEWING, RESOLVED, DISMISSED
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
  resolvedBy  String?

  @@index([status, createdAt])
  @@index([reporterId, gameId, reason, status])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  type      String
  read      Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([userId, read])
}

// Game of the Day — admin-curated with auto-fallback
model FeaturedGame {
  id          String   @id @default(cuid())
  date        DateTime @unique @db.Date // one pick per calendar day
  gameId      String
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  note        String?  // optional admin note
  createdById String
  createdBy   User     @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([gameId])
}

// Game Jams
model GameJam {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  description   String
  theme         String?
  rules         String?
  bannerImage   String?
  status        String   @default("UPCOMING") // UPCOMING, ACTIVE, VOTING, COMPLETED
  startDate     DateTime
  endDate       DateTime
  votingEndDate DateTime
  maxEntries    Int      @default(1) // max entries per user
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  entries GameJamEntry[]

  @@index([status])
  @@index([startDate])
  @@index([endDate])
}

model GameJamEntry {
  id          String   @id @default(cuid())
  jamId       String
  jam         GameJam  @relation(fields: [jamId], references: [id], onDelete: Cascade)
  gameId      String
  game        Game     @relation(fields: [gameId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  submittedAt DateTime @default(now())

  votes GameJamVote[]

  @@unique([jamId, gameId])
  @@index([jamId])
  @@index([jamId, userId])
  @@index([gameId])
  @@index([userId])
}

model GameJamVote {
  id        String   @id @default(cuid())
  entryId   String
  entry     GameJamEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  score     Int      // 1-5
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([entryId, userId])
  @@index([entryId])
  @@index([userId])
}
